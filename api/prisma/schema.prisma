// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ERole {
 USER
 ADMIN 
}

enum EOrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum EPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String?
  lastName      String?
  role          ERole     @default(USER)
  refreshToken  String?

  // OneToMany
  orders        Order[] // OneToMany : One User can have Many Orders.
  carts         Cart[] // OneTomany : One User can have Many Cards.
  payments      Payment[]

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // TO LEARN DEEPER....
  @@index([email]) // For Performance Purpose.
  @@map("users") // The name of the table.
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique @default(cuid())
  status          EOrderStatus
  totalAmount     Decimal       @db.Decimal(10, 2)
  shippingAddress String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // OneToMany
  orderItems      OrderItem[]

  // ManyToOne
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade) // ManyToOne : Many Orders can be owned by One User => One Order is only owned by One User.
  cartId      String?
  cart        Cart?         @relation(fields: [cartId], references: [id]) // ManyToOne : Many Orders can be linked to One Cart => One Order is only linked to zero or one Cart.

  // OneToOne
  payment     Payment?

  // TO LEARN DEEPER....
  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

model Cart {
  id        String      @id @default(uuid())
  isChecked Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // OneToMany
  orders    Order[]
  cartItems CartItem[]

  // ManyToOne
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade) // ManyToOne : Many Cards can be owned by One User => One Card is only owned by One User.
    
  // TO LEARN DEEPER....
  @@index([userId])
  @@map("carts")
}

model Payment {
  id            String          @id @default(uuid())
  amount        Decimal         @db.Decimal(10, 2)
  status        EPaymentStatus  @default(PENDING)
  currency      String          @default("usd")
  paymentMethod String? // For Payment Providers like : Strippe, PayPal, ...
  transactionId String? // The Transaction ID is generated by the payment provider used.

  // ManyToOne
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade) // ManyToOne : Many Payments can be owned by one User => One Payment is only done by One User.
    
  // OneToOne
  orderId String  @unique
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // TO LEARN DEEPER....
  @@index([orderId])
  @@index([userId])
  @@index([transactionId])
  @@map("payments")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  slug        String    @unique
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  //OneToMany
  products    Product[]

  // TO LEARN DEEPER....
  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  stock       Int     @default(0)
  sku         String  @unique
  imageUrl    String?
  isActive    Boolean @default(true)

  // OneToMany
  orderItems  OrderItem[]
  cartItems   CartItem[]

  // ManyToOne
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // TO LEARN DEEPER....
  @@index([sku]) // For Performance Purpose.
  @@index([categoryId]) // For Performance Purpose.
  @@index([isActive]) // For Performance Purpose.
  @@map("products") // The name of the table.
}

model OrderItem {
  id        String    @id @default(uuid())
  quantity  Int
  price     Decimal   @db.Decimal(10, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // ManyToOne
  productId String
  product   Product @relation(fields: [productId], references: [id])
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // TO LEARN DEEPER....
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model CartItem {
  id        String    @id @default(uuid())
  quantity  Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // ManyToOne
  productId String
  product   Product @relation(fields: [productId], references: [id])
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId]) // The combination of cartId and productId must be UNIQUE.

  // TO LEARN DEEPER....
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}